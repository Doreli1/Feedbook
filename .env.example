# העתיקו קובץ זה ל-.env.local ומלאו ערכים אמיתיים.
# .env.local נמצא ב-.gitignore ולעולם לא ייכנס ל-git.
# את הערכים האמיתיים מוצאים ב-Supabase Dashboard > Project Settings > API.

# --- Supabase (client-side, בטוח לחשיפה ב-frontend) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side בלבד — Edge Functions / CI, לעולם לא ב-frontend) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- סליקת תשלומים (Tranzila) ---
TRANZILA_TERMINAL_NAME=
TRANZILA_API_KEY=

# --- שליחת מיילים (Resend) ---
RESEND_API_KEY=

# --- Gemini API (אם בשימוש בלוגיקה עסקית) ---
GEMINI_API_KEY=
